{
  "name": "pickmybrowser",
  "version": "0.1.1",
  "description": "Lightweight, beautiful, cross-platform browser picker (Tauri)",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "build:wdio": "vite build --mode wdio",
    "build:e2e": "node scripts/build-e2e.cjs",
    "test:e2e": "npm run build:e2e && npm run test:e2e:run",
    "test:e2e:run": "wdio run wdio.conf.mjs",
    "test:smoke": "node scripts/smoke-release.cjs",
    "demo": "wdio run scripts/demo.wdio.conf.mjs",
    "version": "node scripts/sync-version.cjs",
    "release:patch": "npm version patch -m \"chore(release): v%s\" && git push --follow-tags",
    "release:minor": "npm version minor -m \"chore(release): v%s\" && git push --follow-tags",
    "release:major": "npm version major -m \"chore(release): v%s\" && git push --follow-tags"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@wdio/cli": "^10.2.0",
    "@wdio/globals": "^10.2.0",
    "@wdio/local-runner": "^10.2.0",
    "@wdio/mocha-framework": "^10.2.0",
    "@wdio/spec-reporter": "^10.2.0",
    "@wdio/tauri-plugin": "2.0.0-next.0",
    "@wdio/tauri-service": "2.0.0-next.0",
    "pngjs": "^7.0.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tengfone/pickmybrowser.git"
  }
}
