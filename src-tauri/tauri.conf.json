{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PickMyBrowser",
  "version": "../package.json",
  "identifier": "com.tengfone.pickmybrowser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self'",
        "form-action": "'none'",
        "default-src": "'self'",
        "img-src": "'self' data:",
        "base-uri": "'none'",
        "object-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "app",
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "tengfone",
    "shortDescription": "Pick which browser opens each link",
    "category": "Utility",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "rpm": {
        "preRemoveScript": "./linux/prerm.sh"
      },
      "deb": {
        "preRemoveScript": "./linux/prerm.sh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY4QkZCNzNFRjg1MEVCNzIKUldSeTYxRDRQcmUvK0NyMzFoT0hVYXRORTE1VkJPVGhjV1ppTVVyR09XMXBXYlFKYzZHRWZBVTkK",
      "endpoints": [
        "https://github.com/tengfone/pickmybrowser/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "mainBinaryName": "pickmybrowser"
}
