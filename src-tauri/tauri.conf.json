{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PickMyBrowser",
  "version": "../package.json",
  "identifier": "com.tengfone.pickmybrowser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "pickmybrowser-tauri",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "tengfone",
    "shortDescription": "Pick which browser opens each link",
    "category": "Utility",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "rpm": {
        "preRemoveScript": "./linux/prerm.sh"
      },
      "deb": {
        "preRemoveScript": "./linux/prerm.sh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "mainBinaryName": "pickmybrowser"
}
