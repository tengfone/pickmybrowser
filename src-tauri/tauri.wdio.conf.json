{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.tengfone.pickmybrowser.e2e",
  "productName": "PickMyBrowser E2E",
  "build": {
    "beforeBuildCommand": "npm run build:wdio"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "wdio",
          "description": "E2E-only: WebdriverIO plugins (merged in by tauri.wdio.conf.json)",
          "windows": ["picker", "settings"],
          "permissions": [
            "wdio:default",
            "wdio-webdriver:default",
            "core:window:allow-set-size",
            "core:window:allow-center",
            "core:window:allow-is-visible",
            "core:window:allow-show",
            "core:window:allow-set-focus",
            "core:window:allow-set-position",
            "core:window:allow-outer-position"
          ]
        }
      ]
    }
  }
}
